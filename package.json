{
  "name": "aruba-cx-syntax",
  "displayName": "Aruba AOS-CX Syntax Highlighter",
  "description": "Syntax highlighting for Aruba AOS-CX switch configuration files",
  "version": "1.1.0",
  "publisher": "SThomson29",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aruba",
    "aos-cx",
    "aoscx",
    "hpe",
    "network",
    "switch",
    "config",
    "vxlan",
    "evpn",
    "vsx"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SThomson29/aruba-cx-syntax"
  },
  "contributes": {
    "languages": [
      {
        "id": "aruba-cx",
        "aliases": ["Aruba AOS-CX", "aoscx", "aruba-cx"],
        "extensions": [
          ".aoscx",
          ".aoscxcfg"
        ],
        "filenames": [],
        "firstLine": "^(hostname |interface |vlan |router |ip route |! Aruba|Current configuration)",
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "aruba-cx",
        "scopeName": "source.aruba-cx",
        "path": "./syntaxes/aruba-cx.tmLanguage.json"
      }
    ]
  }
}
